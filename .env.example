# Beyond Rasooli — Environment Configuration Template
# Copy this file to .env.local or .env for local development.

# Application Server
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ps

# Payload CMS Authentication Secret (generate a strong 32+ character random string in production)
PAYLOAD_SECRET=beyond-rasooli-dev-secret-change-in-production-1234567890

# Database Configuration:
# - SQLite (default for instant zero-dependency local dev): file:./data/beyond_rasooli.sqlite
# - PostgreSQL (production target e.g. Neon, Supabase, self-hosted): postgresql://user:password@host:5432/dbname?sslmode=verify-full
DATABASE_URI=file:./data/beyond_rasooli.sqlite

# Media & Storage (Optional: S3 / Cloudflare R2 bucket credentials for production)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Contact Form & Email Delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@beyondrasooli.com
CONTACT_FROM_EMAIL=notifications@beyondrasooli.com

# Spam Protection (Cloudflare Turnstile)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# YouTube Data API (Optional: used for auto-filling video duration)
YOUTUBE_API_KEY=

# Translation Service Adapters (P1 translate-at-publish)
ANTHROPIC_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_MONTHLY_BUDGET_USD=50

# Analytics & Feature Flags
ENABLE_NEWSLETTER=false
ENABLE_FIRST_PARTY_ANALYTICS=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Scheduling: call the protected POST endpoint every minute from a server-side scheduler.
CRON_SECRET=
# Optional initial founder setup for npm run seed; never use committed credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Translation: founder-selected current model and its verified token prices.
ANTHROPIC_MODEL=
TRANSLATION_INPUT_USD_PER_MILLION=
TRANSLATION_OUTPUT_USD_PER_MILLION=

# Enable only when the hosting proxy overwrites untrusted address headers.
TRUST_PROXY_IP=false

# Optional newsletter: select Buttondown or MailerLite in CMS settings.
NEWSLETTER_API_KEY=
